---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMotion from '../components/PageMotion.astro';
import { siteMeta } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  intro?: boolean;
  footer?: boolean;
}

const {
  title,
  description = siteMeta.description,
  intro = false,
  footer = true,
} = Astro.props;
const pageTitle = title ? `${title} · ${siteMeta.name}` : `${siteMeta.name} — ${siteMeta.tagline}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pt-BR" class:list={[intro && 'has-hero']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,200;1,9..144,300;1,9..144,400&family=Inter:wght@200;300;400;500&family=Lato:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <noscript>
      <style>
        [data-reveal],
        [data-reveal-group] > * {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-coffee focus:px-4 focus:py-2 focus:text-almond"
    >
      Pular para o conteúdo
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <PageMotion />
  </body>
</html>
