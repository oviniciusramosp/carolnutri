---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMotion from '../components/PageMotion.astro';
import { jsonLdGraph, ogImageUrl, siteMeta, siteOrigin } from '../lib/site';

interface Props {
  title?: string;
  fullTitle?: string;
  description?: string;
  intro?: boolean;
  header?: boolean;
  footer?: boolean;
  index?: boolean;
  preloadHero?: boolean;
}

const {
  title,
  fullTitle,
  description = siteMeta.description,
  intro = false,
  header = true,
  footer = true,
  index = true,
  preloadHero = false,
} = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} · ${siteMeta.name}` : siteMeta.title);
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : siteOrigin + '/';
const base = import.meta.env.BASE_URL;
const ogImage = ogImageUrl();
const structuredData = jsonLdGraph(canonical, {
  name: pageTitle,
  description,
});
---

<!doctype html>
<html lang="pt-BR" class:list={[intro && 'has-hero']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2f2e2c" />
    {index ? (
      <meta name="robots" content="index, follow" />
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link
      rel="preload"
      href={`${base}fonts/lato-normal-300.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preloadHero && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        href={`${base}images/hero-1600.webp`}
        imagesrcset={`${base}images/hero-800.webp 800w, ${base}images/hero-1600.webp 1600w`}
        imagesizes="(max-width: 768px) 100vw, min(62vw, 100vh)"
        fetchpriority="high"
      />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteMeta.professionalName}, nutricionista em ${siteMeta.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {index && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-coffee focus:px-4 focus:py-2 focus:text-almond"
    >
      Pular para o conteúdo
    </a>
    {header && <Header />}
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <PageMotion />
  </body>
</html>
