---
import BaseLayout from '../layouts/BaseLayout.astro';

const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout title="Página não encontrada" description="Esta página não existe." index={false}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-4xl font-medium text-coffee">Página não encontrada</h1>
    <p class="mt-4 text-chocolate">
      O endereço que você abriu não existe neste site.
    </p>
    <p class="mt-6">
      <a href={homeHref} class="text-chocolate underline">Voltar ao início</a>
    </p>
  </section>
</BaseLayout>
