<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const nodes = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]');

  function revealAll() {
    nodes.forEach((el) => el.classList.add('is-revealed'));
  }

  if (reduceMotion.matches || !('IntersectionObserver' in window)) {
    revealAll();
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    nodes.forEach((el) => io.observe(el));
    reduceMotion.addEventListener('change', (event) => {
      if (event.matches) {
        io.disconnect();
        revealAll();
      }
    });
  }

  const picture = document.querySelector<HTMLElement>('.hero-photo picture');
  const hasScrollTimeline =
    CSS.supports('animation-timeline: scroll()') ||
    CSS.supports('animation-timeline: scroll(root)');

  if (picture && !hasScrollTimeline && !reduceMotion.matches) {
    const mobileQuery = window.matchMedia('(max-width: 768px)');
    const onScroll = () => {
      const progress = Math.min(Math.max(window.scrollY / window.innerHeight, 0), 1);
      picture.style.transform = mobileQuery.matches
        ? `translateY(${progress * 10}%)`
        : `scale(1.14) translateY(${-4 + progress * 12}%)`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
